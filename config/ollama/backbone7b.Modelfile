# BACKBONE_LOCAL: the second, free, local backbone that runs the full system
# matrix and doubles as the no-API reproduction path.
#
# K = 6 chunks of 120-160 words plus a structured-parse prompt is about 4-5K
# tokens in; 8192 leaves room for the parse out. Pinned here, not left to a
# default that differs between Ollama versions.
#
#   ollama create scopecompose-qwen7b -f config/ollama/backbone7b.Modelfile
FROM qwen2.5:7b-instruct-q4_K_M
PARAMETER num_ctx 8192
PARAMETER temperature 0
PARAMETER seed 0
PARAMETER top_k 1

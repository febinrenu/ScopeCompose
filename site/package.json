{
  "name": "scopecompose-site",
  "private": true,
  "version": "2.0.0",
  "description": "ScopeCompose — the research site. The browser engines in public/engine are verified against the Python by tools/verify_engines.js.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node tools/verify_engines.js",
    "check:dist": "node tools/check_dist.mjs",
    "size": "node tools/size.mjs",
    "smoke": "node tools/smoke.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run check:dist && npm run size"
  },
  "dependencies": {
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

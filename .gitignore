# Secrets - never commit
.env
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# API budget artifacts (regenerable, and the cache can get large)
api_budget/cache.sqlite
api_budget/cache.sqlite-*
logs/
*.costlog.jsonl

# Model + HF caches
models/
.cache/
*.bin
*.safetensors
*.gguf

# Data - versioned releases go out separately, working data does not
benchmark/data/raw/
benchmark/data/interim/
*.tmp.jsonl
mock.jsonl

# Experiment outputs
experiments/runs/
outputs/
*.ckpt
*.pt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
models/

# Site build (Vite)
site/node_modules/
site/dist/
site/test-results/

# Office lock and autosave files
~$*
~WRL*.tmp

# Third-party sources cloned for reading; vendor only what is used, at a pinned commit
third_party/normbench_src/

# Public benchmarks fetched by study/fetch_data.py (redistributed by their authors, pinned by hash)
data/external/

# Study intermediates (rankings, embeddings): regenerable from data/external
study/artifacts/*
!study/artifacts/qualifier/
study/artifacts/qualifier/*
!study/artifacts/qualifier/*.json

# Model outputs per cell (large; results.json and tables are committed instead)

# LaTeX build outputs
paper/*.log
paper/*.aux
paper/*.out
paper/main.pdf

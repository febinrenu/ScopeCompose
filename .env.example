# Copy to .env and fill in. .env is gitignored: never commit real keys.
# Keys are needed only to rerun the hosted generators (README, Section 8, Level 2).
# Recomputing the results from the saved outputs needs no keys at all.

# Groq: gpt-oss-20b (hosted replication) and Qwen3.8-27B (prompt tuning)
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA API: gpt-oss-20b once Groq's daily quota is spent, Gemma-4-31B, Nemotron-3-Ultra
NVIDIA_API_KEY=nvapi_your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional standby key, used when the first is rate-limited or failing (answers record nvidia2)
NVIDIA_API_KEY_2=

# Local Ollama: the two primary generators (create them from config/ollama/*.Modelfile)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Optional: any other OpenAI-compatible provider (not used by the study)
FRONTIER_API_KEY=
FRONTIER_BASE_URL=

# Response cache and cost log
CONFLICT_RAG_CACHE=api_budget/cache.sqlite
CONFLICT_RAG_COSTLOG=logs/api_cost.jsonl

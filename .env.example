# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Groq (primary provider, OpenAI-compatible endpoint)
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama fallback (used on rate-limit or when offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Optional: a frontier provider, if budget ever appears.
# Leaving these blank is the supported default - see README section 5.
FRONTIER_API_KEY=
FRONTIER_BASE_URL=

# Paths
CONFLICT_RAG_CACHE=api_budget/cache.sqlite
CONFLICT_RAG_COSTLOG=logs/api_cost.jsonl

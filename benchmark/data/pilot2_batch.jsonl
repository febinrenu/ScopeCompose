{"contract_version": "1.2.0", "query_id": "wp2_0003", "query": "[to be written by the annotator]", "domain": "immigration_eligibility", "construction": "split", "separation": "same_guide", "passages": [{"id": "p0", "text": "You’ll need to provide proof of your finances, if you’re not applying on the basis of your private life", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/uk-family-visa/provide-information", "document_id": "uk-family-visa#provide-information"}, {"id": "p1", "text": "You do not need to meet a minimum income requirement if your partner gets one of the following benefits: Disability Living Allowance, Scottish Adult Disability Living Allowance, Severe Disablement Allowance, Industrial Injuries Disablement Benefit, Attendance Allowance, Pension Age Disability Payment, Carer’s Allowance, Carer Support Payment, Personal Independence Payment, Armed Forces Independence Payment or Guaranteed Income Payment under the Armed Forces Compensation Scheme, Constant Attendance Allowance, Mobility Supplement or War Disablement Pension under the War Pensions Scheme, Police Injury Pension, Child Disability Payment, Adult Disability Payment", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/uk-family-visa/proof-income-partner", "document_id": "uk-family-visa#proof-income-partner"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

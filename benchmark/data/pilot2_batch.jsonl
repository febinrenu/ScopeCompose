{"contract_version": "1.2.0", "query_id": "wp2_0000", "query": "[to be written by the annotator]", "domain": "immigration_eligibility", "construction": "split", "separation": "same_guide", "passages": [{"id": "p0", "text": "You must pay the healthcare surcharge for each year of your stay", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/skilled-worker-visa", "document_id": "skilled-worker-visa#overview"}, {"id": "p1", "text": "If you’re a doctor or nurse, or you work in health or adult social care, check if you’re eligible to apply for the Health and Care Worker visa instead. It’s cheaper to apply for and you do not need to pay the annual immigration health surcharge.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/skilled-worker-visa/how-much-it-costs", "document_id": "skilled-worker-visa#how-much-it-costs"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp2_0001", "query": "[to be written by the annotator]", "domain": "immigration_eligibility", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "You cannot extend your Graduate visa.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/graduate-visa", "document_id": "graduate-visa#overview"}, {"id": "p1", "text": "You may be able to extend your visa if you’re eligible, for example to continue your studies in the UK.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/student-visa", "document_id": "student-visa#overview"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

{"contract_version": "1.2.0", "query_id": "wp2_0009", "query": "[to be written by the annotator]", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "A Standard Visitor may apply for a visit visa of six months, two, five or 10 years validity, however each stay in the UK must not exceed the permitted length of stay endorsed on the visit visa (usually six months).", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/guidance/immigration-rules/immigration-rules-appendix-v-visitor", "document_id": "guidance/immigration-rules/immigration-rules-appendix-v-visitor"}, {"id": "p1", "text": "If your treatment will last longer than 6 months All visits for medical treatment lasting longer than 6 months require a Standard Visitor visa regardless of your nationality.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/standard-visitor/visit-for-medical-reasons", "document_id": "standard-visitor#visit-for-medical-reasons"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

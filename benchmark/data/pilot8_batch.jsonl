{"contract_version": "1.2.0", "query_id": "wp8_0000", "query": "How long can seasonal workers stay in the UK?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "You can come to the UK for a maximum of up to 12 months, or the time given in your certificate of sponsorship plus up to 28 days, whichever is shorter.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/creative-worker-visa", "document_id": "creative-worker-visa#overview"}, {"id": "p1", "text": "changes in this guidance will permit seasonal workers to spend no more than 6 months working in the UK during any rolling 10-month period, rather than any rolling 12-month period", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/government/publications/guidance-on-application-for-uk-visa-under-tier-5-temporary-worker/temporary-work-caseworker-guidance-accessible", "document_id": "government/publications/guidance-on-application-for-uk-visa-under-tier-5-temporary-worker/temporary-work-caseworker-guidance-accessible"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

{"contract_version": "1.2.0", "query_id": "wp8_0003", "query": "What is the maximum allowed absence for continuous residence?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "The applicant must have met the continuous residence requirement set out in Appendix Continuous Residence for the entirety of the qualifying period.", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/guidance/immigration-rules/immigration-rules-appendix-long-residence", "document_id": "guidance/immigration-rules/immigration-rules-appendix-long-residence"}, {"id": "p1", "text": "For any absence from the UK with permission granted under the rules in place before 11 January 2018, the applicant must not have been outside the UK for more than 180 days during any consecutive 12‑month period, ending on the same date of their current application unless CR 3.3 applies, and subject to CR 3.4.", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/guidance/immigration-rules/immigration-rules-appendix-continuous-residence", "document_id": "guidance/immigration-rules/immigration-rules-appendix-continuous-residence"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp8_0004", "query": "Can someone over 18 apply if they have UK stay permission?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "If you’re 18 or over, you can only apply if you have permission to stay in the UK (‘leave to enter or remain’) which started when you were under 18.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/uk-family-visa/child", "document_id": "uk-family-visa#child"}, {"id": "p1", "text": "The applicant may be aged 18 or older on the date of application if the applicant was last granted entry clearance or permission to stay as the dependent child of their parent or parents, and either: (a) the entry clearance or permission to stay is valid on the date of application or expired no more than 14 days before the date of application, except that where the Exceptions for overstayers section of Part Suitability applies that period of overstaying will be disregarded; or (b) the applicant is applying as a dependent child under Appendix Bereaved Partner or Appendix Victim of Domestic Abuse.", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/guidance/immigration-rules/immigration-rules-appendix-children", "document_id": "guidance/immigration-rules/immigration-rules-appendix-children"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp8_0005", "query": "How long can you stay in the UK on this visa?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "You can stay in the UK for 2 years and 9 months on this visa. After this you’ll need to apply to extend your stay.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/uk-family-visa/parent", "document_id": "uk-family-visa#parent"}, {"id": "p1", "text": "If you extend your family visa or switch to this visa you can stay in the UK for 2 years and 6 months.", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/guidance/immigration-rules/immigration-rules-appendix-fm-family-members", "document_id": "guidance/immigration-rules/immigration-rules-appendix-fm-family-members"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp8_0006", "query": "What is the age requirement for a child applicant?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "CHI 1.1. The applicant must be under the age of 18 on the date of application unless CHI 1.2 applies.", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/guidance/immigration-rules/immigration-rules-appendix-children", "document_id": "guidance/immigration-rules/immigration-rules-appendix-children"}, {"id": "p1", "text": "Where a child has reached their 18th birthday after the date of application but before the date of decision, you must assess the application as if the applicant was still under 18.", "source_type": "unknown", "date": null, "source_url": "https://www.gov.uk/government/publications/appendix-children-caseworker-guidance/appendix-children-accessible", "document_id": "government/publications/appendix-children-caseworker-guidance/appendix-children-accessible"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

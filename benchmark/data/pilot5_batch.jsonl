{"contract_version": "1.2.0", "query_id": "wp5_0013", "query": "How many Reward Platinum accounts can I have?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "You can only have one Reward Platinum account in your sole name.", "source_type": "unknown", "date": null, "source_url": "https://www.natwest.com/current-accounts/reward_platinum_account.html", "document_id": "current-accounts/reward_platinum_account.html"}, {"id": "p1", "text": "You can have more than one joint Reward Platinum account, as long as the other account holder is different on each one.", "source_type": "unknown", "date": null, "source_url": "https://www.natwest.com/current-accounts/rates-and-charges.html", "document_id": "current-accounts/rates-and-charges.html"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

{"contract_version": "1.2.0", "query_id": "wp5_0022", "query": "What do you, your partner, or children need to do?", "domain": "immigration_eligibility", "construction": "split", "separation": "same_guide", "passages": [{"id": "p0", "text": "You, your partner or children will each need to:", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/skilled-worker-visa", "document_id": "skilled-worker-visa#overview"}, {"id": "p1", "text": "If your 5-year certificate of sponsorship expires in 2027 and your child applies to join you in 2025, they’ll need to pay the application fee for more than 3 years.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/skilled-worker-visa/how-much-it-costs", "document_id": "skilled-worker-visa#how-much-it-costs"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp5_0023", "query": "How can I keep track of my account balance?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "and what to do if things go wrong", "source_type": "unknown", "date": null, "source_url": "https://www.lloydsbank.com/assets/media/pdfs/current-accounts/personal_banking_terms_and_conditions.pdf", "document_id": "assets/media/pdfs/current-accounts/personal_banking_terms_and_conditions.pdf"}, {"id": "p1", "text": "By using our Mobile Banking app you can set up push notifications for when your balance after pending, drops between £0 and £50.", "source_type": "unknown", "date": null, "source_url": "https://www.lloydsbank.com/current-accounts/overdrafts.html", "document_id": "current-accounts/overdrafts.html"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}

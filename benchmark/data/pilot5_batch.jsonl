{"contract_version": "1.2.0", "query_id": "wp5_0015", "query": "How much overdraft is interest‑free?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "Most of our accounts (except our Basic Bank Account) come with an interest‑free amount.", "source_type": "unknown", "date": null, "source_url": "https://www.hsbc.co.uk/current-accounts/products/bank-account/", "document_id": "current-accounts/products/bank-account"}, {"id": "p1", "text": "Bank Account 34.05% 39.9% EAR variable No interest on the first £25 of your arranged or unarranged overdraft.", "source_type": "unknown", "date": null, "source_url": "https://www.hsbc.co.uk/current-accounts/interest-rates-and-charges/", "document_id": "current-accounts/interest-rates-and-charges"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp5_0016", "query": "When did changes occur to 1|2|3 accounts?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "From 20 June 2023, we removed the 1|2|3 Current Account and Select Current Account from our product range.", "source_type": "unknown", "date": null, "source_url": "https://www.santander.co.uk/personal/support/current-accounts/important-information-for-accounts-no-longer-available-to-open", "document_id": "/current-accounts/important-information-for-accounts-no-longer-available-to-open"}, {"id": "p1", "text": "From 11 May 2026, we’re increasing the monthly fee on our 1|2|3, Select and Private current accounts from £4 to £5.", "source_type": "unknown", "date": null, "source_url": "https://www.santander.co.uk/personal/support/current-accounts/changes-to-your-current-account", "document_id": "personal/support/current-accounts/changes-to-your-current-account"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp5_0017", "query": "What happens if I cancel Extra?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "If you cancel Extra you’ll lose access to its benefits, but we’ll keep your Monzo Current Account open.", "source_type": "unknown", "date": null, "source_url": "https://monzo.com/legal/extra/terms-and-conditions", "document_id": "legal/extra/terms-and-conditions"}, {"id": "p1", "text": "If you cancel Extra you can continue using your benefits until your next payment date, but you won’t get a refund.", "source_type": "unknown", "date": null, "source_url": "https://monzo.com/legal/plans/fee-information", "document_id": "legal/plans/fee-information"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp5_0018", "query": "What happens to the fee after the 6‑month period?", "domain": "financial_terms", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "After 14 days, but within 6 months of signing up £50 fee (if you've ordered a metal card). We'll refund you for any remaining days in the month you cancel.", "source_type": "unknown", "date": null, "source_url": "https://monzo.com/legal/premium/terms-and-conditions", "document_id": "legal/premium/terms-and-conditions"}, {"id": "p1", "text": "After your 6-month minimum terms ends No fee. We'll refund you for any remaining days in the month you cancel.", "source_type": "unknown", "date": null, "source_url": "https://monzo.com/legal/premium/fee-information", "document_id": "legal/premium/fee-information"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp5_0019", "query": "How much money is needed for a UK student visa?", "domain": "immigration_eligibility", "construction": "split", "separation": "same_guide", "passages": [{"id": "p0", "text": "You must have enough money to pay for your course and support yourself in the UK.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/student-visa/money", "document_id": "student-visa#money"}, {"id": "p1", "text": "£558 to apply for a Student visa from outside the UK", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/student-visa", "document_id": "student-visa#overview"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
{"contract_version": "1.2.0", "query_id": "wp5_0020", "query": "How can I speed up my visa application?", "domain": "immigration_eligibility", "construction": "natural", "separation": "cross_document", "passages": [{"id": "p0", "text": "You may be able to pay to get a faster decision.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/global-talent-digital-technology", "document_id": "global-talent-digital-technology#overview"}, {"id": "p1", "text": "To get a Global Talent visa you usually need to apply for an endorsement to prove that you’re a leader or potential leader, as well as for the visa itself.", "source_type": "government_guidance", "date": null, "source_url": "https://www.gov.uk/global-talent-researcher-academic", "document_id": "global-talent-researcher-academic#overview"}], "conflict_pairs": [], "multi_exception_flags": {"nested": false, "crossed": false}}
